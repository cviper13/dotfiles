procps/

# File managers
dolphinrc
Thunar/
xfce4/

# Browsers & Web Apps
google-chrome/
Microsoft/
Microsoft Teams - Preview/
Element/

# IDEs & Editors (keep personal configs, ignore workspaces)
Code/
GIMP/

# Communication & Media
teams-for-linux/
vesktop/
Soundux/

# Utilities & Tools
copyq/
obs-studio/
OpenRGB/
Mullvad VPN/
remmina/
freerdp/
tigervnc/
wireshark/
qt5ct/
