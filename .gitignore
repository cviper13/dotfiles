# Games & Gaming Tools
csgo-mm-server-picker/
bruno/
jnbot/

# Temporary & Cache files
*.tmp
*.cache
*.log
*.lock
user-dirs.dirs
user-dirs.locale
mimeapps.list
trashrc

# =============================================================================
# Keep these (commonly shared configs):
# dunst/ or mako/ - Notifications
# rofi/ - Application launcher
# fish/ - Shell config
# helix/ - Editor config
# fontconfig/ - Font settings
# gtk-3.0/, gtkrc* - GTK theming
# wal/ - Color schemes
# neofetch/ - System info
# htop/ - Process monitor
# mpv/ - Media player
# gh/ - GitHub CLI
# scripts/ - Custom scripts
# waybar/ - Status bar
# ghostty/ - Terminal emulator
# libreoffice/ - Office suite config
# =============================================================================
